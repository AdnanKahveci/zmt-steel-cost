<UserControl x:Class="ZMT.SteelCost.App.Views.ProjectInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ZMT.SteelCost.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,18" />
            <views:CalculationStepBar />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Müşteri ve Teklif" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Firma *" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.ActiveProject.Company, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                        <TextBlock Text="Müşteri Adı *" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.ActiveProject.CustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                        <TextBlock Text="CRM No" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.ActiveProject.CrmNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                        <TextBlock Text="Düzenlenme Tarihi" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding Owner.ActiveProject.DocumentDate}" Margin="0,0,0,12" />
                        <TextBlock Text="Proje Aşaması" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ProjectStages}" SelectedItem="{Binding Owner.ActiveProject.Stage}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Proje Ekibi" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Teklif Sayımı Yapan" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.ActiveProject.OfferPreparedBy, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                        <TextBlock Text="Proje Kontrolü Yapan" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.ActiveProject.ProjectCheckedBy, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                        <TextBlock Text="Üretim Listesi Yapan" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.ActiveProject.ProductionListPreparedBy, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />
                        <Border Background="#EAF8F8" BorderBrush="#A7E2E3" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel><TextBlock Text="Proje snapshot koruması" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" /><TextBlock Text="Kaydedilen fiyatlar, bina girdileri, FormulaVersion ve hesap satırları değişmez snapshot olarak tutulur." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" /></StackPanel>
                        </Border>
                        <Button Content="Bina Bilgilerine Devam Et  →" Style="{StaticResource PrimaryButton}" Command="{Binding Owner.NavigateCommand}" CommandParameter="Building" HorizontalAlignment="Right" Margin="0,24,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
