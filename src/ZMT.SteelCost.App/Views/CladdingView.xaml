<UserControl x:Class="ZMT.SteelCost.App.Views.CladdingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ZMT.SteelCost.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,18" />
            <views:CalculationStepBar />
            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dış Duvar" Style="{StaticResource SectionTitle}" /><TextBlock Text="Duvar Uzunluğu (m)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding ExteriorLength}" Margin="0,0,0,12" /><TextBlock Text="Katman 1" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding ExteriorLayer1}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Katman 2" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding ExteriorLayer2}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Katman 3" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding ExteriorLayer3}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="İç Duvar" Style="{StaticResource SectionTitle}" /><TextBlock Text="Duvar Uzunluğu (m)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding InteriorLength}" Margin="0,0,0,12" /><TextBlock Text="Katman 1" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding InteriorLayer1}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Katman 2" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding InteriorLayer2}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Katman 3" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding InteriorLayer3}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Çatı" Style="{StaticResource SectionTitle}" /><TextBlock Text="Hesaplanan Alan" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding RoofArea, StringFormat={}{0:N3} m²}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,12" /><TextBlock Text="Katman 1" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding RoofLayer1}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Katman 2" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding RoofLayer2}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Katman 3" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding RoofLayer3}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Tavan ve Islak Hacim" Style="{StaticResource SectionTitle}" /><TextBlock Text="Tavan Alanı (m²)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding CeilingArea}" Margin="0,0,0,8" /><TextBlock Text="Katman 1" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding CeilingLayer1}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Islak Hacim Duvar (m)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding WetWallLength}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Islak Hacim Tavan (m²)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding WetCeilingArea}" /></StackPanel></Grid></StackPanel></Border>
            </UniformGrid>
            <Button Content="Kapı / Pencereye Devam Et  →" Style="{StaticResource PrimaryButton}" Command="{Binding Owner.NavigateCommand}" CommandParameter="DoorWindow" HorizontalAlignment="Right" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
