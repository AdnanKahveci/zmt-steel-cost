<UserControl x:Class="ZMT.SteelCost.App.Views.OfferEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="920" MinHeight="620">
    <UserControl.Resources>
        <Style x:Key="EditorTab" TargetType="TabItem">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Ayrıntılı Teklif Formu" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Hesap sonucunu müşteriye sunulacak düzenlenebilir teklif ve teknik dosyaya dönüştürün."
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF8F8" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                <TextBlock Text="{Binding ImagesSummary}" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="10" Margin="0,0,0,12">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Hesaptan Yenile" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshFromCalculationCommand}" Margin="4,0" />
                    <Button Content="PDF Önizle" Style="{StaticResource SecondaryButton}" Command="{Binding PreviewPdfCommand}" Margin="4,0" />
                    <Button Content="Teklif PDF Oluştur" Style="{StaticResource PrimaryButton}" Command="{Binding ExportPdfCommand}" Margin="4,0" />
                </WrapPanel>
                <StackPanel VerticalAlignment="Center" Margin="6,0,12,0">
                    <TextBlock Text="Düzenleme Modu" FontWeight="SemiBold" />
                    <TextBlock Text="Form değişiklikleri yalnızca teklif PDF'sine uygulanır; maliyet hesabını değiştirmez."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" Padding="6"
                    ItemContainerStyle="{StaticResource EditorTab}">
            <TabItem Header="1  Teklif Bilgileri">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel MaxWidth="1120" HorizontalAlignment="Left">
                        <TextBlock Text="Müşteri ve teklif bilgileri" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,14,8"><TextBlock Text="Teklif Tarihi" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding Info.OfferDate}" /></StackPanel>
                            <StackPanel Margin="0,0,14,8"><TextBlock Text="Teklifi Hazırlayan" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Info.PreparedBy, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,0,8"><TextBlock Text="Referans / CRM No" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Info.ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,14,8"><TextBlock Text="Firma / Proje" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Info.CompanyName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,14,8"><TextBlock Text="Yetkili Kişi" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Info.AuthorizedPerson, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Margin="0,0,0,8"><TextBlock Text="İletişim Bilgisi" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Info.ContactInfo, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="İş / Proje Adı" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Info.JobName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Ana Başlık" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                        <TextBox Text="{Binding Info.MainTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Görsel Sayfaları Proje Başlığı" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                        <TextBox Text="{Binding Info.ProjectTitle, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="2  Dahil / Hariç İşler">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel><Button DockPanel.Dock="Right" Content="Grup Ekle" Style="{StaticResource SecondaryButton}" Command="{Binding AddIncludedGroupCommand}" /><TextBlock Text="Fiyatımıza Dahil İşler" Style="{StaticResource SectionTitle}" /></DockPanel>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding IncludedGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="12">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsVisible}" Content="PDF" Margin="0,6,10,0" />
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Button Content="Madde Ekle" Style="{StaticResource SecondaryButton}"
                                                                    Command="{Binding DataContext.AddIncludedItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                                            <Button Content="Grubu Sil" Style="{StaticResource DangerButton}"
                                                                    Command="{Binding DataContext.RemoveIncludedGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" Margin="0,0,8,8" />
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                                    <CheckBox IsChecked="{Binding IsIncludedInPdf}" VerticalAlignment="Center" ToolTip="PDF'ye dahil et" />
                                                                    <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,6,4" />
                                                                    <Button Grid.Column="2" Content="Sil" Style="{StaticResource SecondaryButton}" Padding="8,5"
                                                                            Command="{Binding DataContext.RemoveIncludedItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top"><Button DockPanel.Dock="Right" Content="Madde Ekle" Style="{StaticResource SecondaryButton}" Command="{Binding AddExcludedItemCommand}" /><TextBlock Text="Fiyatımıza Dahil Olmayan İşler" Style="{StaticResource SectionTitle}" /></DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Seçili Maddeyi Sil" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Command="{Binding RemoveExcludedItemCommand}" Margin="0,10,0,0" />
                            <DataGrid ItemsSource="{Binding ExcludedWorks}" SelectedItem="{Binding SelectedExcludedItem}" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="PDF" Binding="{Binding IsIncludedInPdf}" Width="46" />
                                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="3  Teklif Kalemleri">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0"><TextBlock Text="Teklif Tablosu Başlığı" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding OfferTitle, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="Teklif Para Birimi" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" /></StackPanel>
                        <Button Grid.Column="2" Content="Yeni Kalem Ekle" Style="{StaticResource PrimaryButton}" Command="{Binding AddOfferItemCommand}" VerticalAlignment="Center" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding OfferItems}" SelectedItem="{Binding SelectedOfferItem}" CanUserAddRows="False" Margin="0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RowNo}" IsReadOnly="True" Width="46" />
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="260" />
                            <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="95" />
                            <DataGridTextColumn Header="Birim" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="125" />
                            <DataGridTextColumn Header="Para" Binding="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Toplam" Binding="{Binding Total, StringFormat=N2}" IsReadOnly="True" Width="135" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,0,0,10">
                        <WrapPanel DockPanel.Dock="Left">
                            <Button Content="Yukarı" Style="{StaticResource SecondaryButton}" Command="{Binding MoveOfferItemUpCommand}" />
                            <Button Content="Aşağı" Style="{StaticResource SecondaryButton}" Command="{Binding MoveOfferItemDownCommand}" />
                            <Button Content="Seçili Kalemi Sil" Style="{StaticResource DangerButton}" Command="{Binding RemoveOfferItemCommand}" />
                        </WrapPanel>
                        <UniformGrid Columns="5" HorizontalAlignment="Right">
                            <Border Background="#F7F9FC" CornerRadius="7" Padding="12" Margin="4"><StackPanel><TextBlock Text="Kapsam" Style="{StaticResource SummaryLabel}" /><TextBlock Text="{Binding ScopeTotal, StringFormat=N2}" Style="{StaticResource SummaryValue}" /></StackPanel></Border>
                            <Border Background="#F7F9FC" CornerRadius="7" Padding="12" Margin="4"><StackPanel><TextBlock Text="İskonto" Style="{StaticResource SummaryLabel}" /><TextBlock Text="{Binding DiscountAmount, StringFormat=N2}" Style="{StaticResource SummaryValue}" /></StackPanel></Border>
                            <Border Background="#F7F9FC" CornerRadius="7" Padding="12" Margin="4"><StackPanel><TextBlock Text="Ara Toplam" Style="{StaticResource SummaryLabel}" /><TextBlock Text="{Binding Subtotal, StringFormat=N2}" Style="{StaticResource SummaryValue}" /></StackPanel></Border>
                            <Border Background="#F7F9FC" CornerRadius="7" Padding="12" Margin="4"><StackPanel><TextBlock Text="KDV" Style="{StaticResource SummaryLabel}" /><TextBlock Text="{Binding VatAmount, StringFormat=N2}" Style="{StaticResource SummaryValue}" /></StackPanel></Border>
                            <Border Background="#EAF8F8" CornerRadius="7" Padding="12" Margin="4"><StackPanel><TextBlock Text="Genel Toplam" Style="{StaticResource SummaryLabel}" /><TextBlock Text="{Binding GrandTotal, StringFormat=N2}" Style="{StaticResource SummaryValue}" Foreground="{StaticResource PrimaryDarkBrush}" /></StackPanel></Border>
                        </UniformGrid>
                    </DockPanel>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="İskonto %" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="KDV %" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding VatPercent, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Teklif Notları" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding OfferNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" /></StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="4  Ödeme / Teslim">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top"><Button DockPanel.Dock="Right" Content="Koşul Ekle" Style="{StaticResource SecondaryButton}" Command="{Binding AddPaymentItemCommand}" /><TextBlock Text="Ödeme Şekli" Style="{StaticResource SectionTitle}" /></DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Seçili Koşulu Sil" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Command="{Binding RemovePaymentItemCommand}" Margin="0,10,0,0" />
                            <DataGrid ItemsSource="{Binding PaymentItems}" SelectedItem="{Binding SelectedPaymentItem}" CanUserAddRows="False">
                                <DataGrid.Columns><DataGridCheckBoxColumn Header="PDF" Binding="{Binding IsIncludedInPdf}" Width="50" /><DataGridTextColumn Header="Ödeme Koşulu" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*" /></DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Teslim Süresi ve Açıklaması" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Bu metin teklifin E — Teslim Süresi bölümünde aynen yer alır." Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                            <TextBox Text="{Binding DeliveryText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="5  Görseller">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Teklif görselleri ilk sayfalara; teknik şartname görselleri ise teslim bölümünden sonra eklenir. Sayfa numarası aynı olan iki görsel aynı PDF sayfasında yer alır."
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                    <TabControl Grid.Row="1">
                        <TabItem Header="Teklif Görselleri">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Görsel Ekle" Style="{StaticResource PrimaryButton}" Command="{Binding AddOfferImagesCommand}" />
                                    <Button Content="Yukarı" Style="{StaticResource SecondaryButton}" Command="{Binding MoveOfferImageUpCommand}" />
                                    <Button Content="Aşağı" Style="{StaticResource SecondaryButton}" Command="{Binding MoveOfferImageDownCommand}" />
                                    <Button Content="Seçili Görseli Sil" Style="{StaticResource DangerButton}" Command="{Binding RemoveImageCommand}" CommandParameter="{Binding SelectedOfferImage}" />
                                </WrapPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding OfferImages}" SelectedItem="{Binding SelectedOfferImage}" RowHeight="62" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Önizleme" Width="96"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="78" Height="52" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><Image Source="{Binding FilePath, Converter={StaticResource FilePathToImage}, ConverterParameter=160}" Stretch="Uniform" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridCheckBoxColumn Header="PDF" Binding="{Binding IncludeInPdf}" Width="48" />
                                        <DataGridTextColumn Header="Sıra" Binding="{Binding SortOrder}" IsReadOnly="True" Width="50" />
                                        <DataGridTextColumn Header="Sayfa" Binding="{Binding PageNumber, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                                        <DataGridTextColumn Header="Başlık" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridCheckBoxColumn Header="Çerçeve" Binding="{Binding HasBorder}" Width="72" />
                                        <DataGridCheckBoxColumn Header="Oranı Koru" Binding="{Binding FitWithoutCrop}" Width="78" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Teknik Şartname Görselleri">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Görsel Ekle" Style="{StaticResource PrimaryButton}" Command="{Binding AddTechnicalImagesCommand}" />
                                    <Button Content="Yukarı" Style="{StaticResource SecondaryButton}" Command="{Binding MoveTechnicalImageUpCommand}" />
                                    <Button Content="Aşağı" Style="{StaticResource SecondaryButton}" Command="{Binding MoveTechnicalImageDownCommand}" />
                                    <Button Content="Seçili Görseli Sil" Style="{StaticResource DangerButton}" Command="{Binding RemoveImageCommand}" CommandParameter="{Binding SelectedTechnicalImage}" />
                                </WrapPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding TechnicalImages}" SelectedItem="{Binding SelectedTechnicalImage}" RowHeight="62" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Önizleme" Width="96"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="78" Height="52" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><Image Source="{Binding FilePath, Converter={StaticResource FilePathToImage}, ConverterParameter=160}" Stretch="Uniform" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridCheckBoxColumn Header="PDF" Binding="{Binding IncludeInPdf}" Width="48" />
                                        <DataGridTextColumn Header="Sıra" Binding="{Binding SortOrder}" IsReadOnly="True" Width="50" />
                                        <DataGridTextColumn Header="Sayfa" Binding="{Binding PageNumber, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                                        <DataGridTextColumn Header="Başlık" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridCheckBoxColumn Header="Çerçeve" Binding="{Binding HasBorder}" Width="72" />
                                        <DataGridCheckBoxColumn Header="Oranı Koru" Binding="{Binding FitWithoutCrop}" Width="78" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="6  Teknik Şartname">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0"><TextBlock Text="Teknik Şartname Başlığı" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding TechnicalSpecificationTitle, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <Button Grid.Column="1" Content="Bölüm Ekle" Style="{StaticResource PrimaryButton}" Command="{Binding AddTechnicalSectionCommand}" VerticalAlignment="Center" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TechnicalSections}" SelectedItem="{Binding SelectedTechnicalSection}" CanUserAddRows="False" Margin="0,10" RowHeight="100">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="PDF" Binding="{Binding IncludeInPdf}" Width="50" />
                            <DataGridTextColumn Header="#" Binding="{Binding SortOrder}" IsReadOnly="True" Width="44" />
                            <DataGridTextColumn Header="Bölüm Başlığı" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="250" />
                            <DataGridTemplateColumn Header="İçerik (Etiket ve değer arasına TAB koyabilirsiniz)" Width="*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="3" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2" Content="Seçili Bölümü Sil" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Command="{Binding RemoveTechnicalSectionCommand}" />
                </Grid>
            </TabItem>

            <TabItem Header="7  Firma / PDF">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <Grid MaxWidth="1120" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Firma ve Kurumsal Bilgiler" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Firma Adı" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Company.CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Adres" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Company.Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Telefon" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Company.Phone, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Margin="8,0,0,0"><TextBlock Text="E-posta" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Company.Email, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Web Sitesi" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Company.Website, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Üst Logo Dosyası" Style="{StaticResource FieldLabel}" />
                            <DockPanel><Button DockPanel.Dock="Right" Content="Logo Seç" Style="{StaticResource SecondaryButton}" Command="{Binding SelectLogoCommand}" Margin="8,0,0,0" /><TextBox Text="{Binding Company.HeaderLogoPath, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                            <Border Height="150" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="#F8FAFC"><Image Source="{Binding Company.HeaderLogoPath, Converter={StaticResource FilePathToImage}, ConverterParameter=400}" Stretch="Uniform" Margin="10" /></Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PDF Seçenekleri" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="PDF Dili" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <CheckBox Content="Teklif ve şartname görsellerini ekle" IsChecked="{Binding IncludeImages}" Margin="0,12,0,8" />
                            <CheckBox Content="Teknik şartnameyi ekle" IsChecked="{Binding IncludeTechnicalSpecification}" Margin="0,4,0,8" />
                            <CheckBox Content="Oluşturulduktan sonra PDF'yi aç" IsChecked="{Binding OpenAfterExport}" Margin="0,4,0,18" />
                            <TextBlock Text="Filigran Metni" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Company.WatermarkText, UpdateSourceTrigger=PropertyChanged}" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Filigran Opaklığı" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Company.WatermarkOpacity, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Margin="8,0,0,0"><TextBlock Text="Filigran Açısı" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Company.WatermarkAngle, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </UniformGrid>
                            <Button Content="PDF Önizle" Style="{StaticResource SecondaryButton}" Command="{Binding PreviewPdfCommand}" Margin="0,16,0,8" />
                            <Button Content="Teklif PDF Oluştur ve Kaydet" Style="{StaticResource PrimaryButton}" Command="{Binding ExportPdfCommand}" />
                            <Button Content="Son PDF'yi Aç" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLastPdfCommand}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding LastGeneratedPdfPath}" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#EAF8F8" BorderBrush="#BCE7E8" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryDarkBrush}" />
        </Border>
    </Grid>
</UserControl>
