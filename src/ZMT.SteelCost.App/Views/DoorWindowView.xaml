<UserControl x:Class="ZMT.SteelCost.App.Views.DoorWindowView" x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ZMT.SteelCost.App.Converters"
             xmlns:views="clr-namespace:ZMT.SteelCost.App.Views">
    <UserControl.Resources>
        <converters:BindingProxy x:Key="DataContextProxy" Data="{Binding}" />
    </UserControl.Resources>
    <Grid Margin="0,0,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,18" />
        </StackPanel>
        <views:CalculationStepBar Grid.Row="1" />

        <Border Grid.Row="2" Background="#E8F8F8" BorderBrush="#9CDDDD" BorderThickness="1"
                CornerRadius="7" Padding="12,9" Margin="0,0,0,10">
            <TextBlock Text="Kullanılmayacak kapı veya pencerenin adedini 0 yapın. Renk ve adet değişiklikleri Fiyatı Hesapla ile teklife uygulanır."
                       Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Kapılar" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Adedi elle değiştirebilir, istemediğiniz satırı 0 yapabilirsiniz."
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Owner.ActiveProject.Building.Doors}"
                              FontSize="13" RowHeight="38" ColumnHeaderHeight="38">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Visibility">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource ZeroQuantityVisibility}">
                                            <Binding Path="Quantity" />
                                            <Binding Path="Data.Owner.HideZeroDoorWindows" Source="{StaticResource DataContextProxy}" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Tip / Ölçü" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Type, Converter={StaticResource EnumToTurkish}}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Adet" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="4,2" Padding="8,3" TextAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Pencereler" Style="{StaticResource SectionTitle}" />
                        <DockPanel Margin="0,0,0,10">
                            <CheckBox DockPanel.Dock="Right" Content="Sıfır adetli satırları gizle"
                                      IsChecked="{Binding Owner.HideZeroDoorWindows}" VerticalAlignment="Center" />
                            <TextBlock Text="Her pencerenin adedini ve rengini ayrı ayrı seçebilirsiniz."
                                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Owner.ActiveProject.Building.Windows}"
                              FontSize="13" RowHeight="38" ColumnHeaderHeight="38">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Visibility">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource ZeroQuantityVisibility}">
                                            <Binding Path="Quantity" />
                                            <Binding Path="Data.Owner.HideZeroDoorWindows" Source="{StaticResource DataContextProxy}" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Tip / Ölçü" Width="2*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Type, Converter={StaticResource EnumToTurkish}}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Adet" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="4,2" Padding="8,3" TextAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Renk" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.WindowColors, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="4,2" Padding="5,2">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Fiyatı Hesapla" Style="{StaticResource SecondaryButton}"
                    Command="{Binding Owner.CalculateAndShowResultsCommand}" Margin="4,0" />
            <Button Content="Vitrifiyeye Devam Et  →" Style="{StaticResource PrimaryButton}"
                    Command="{Binding Owner.NavigateCommand}" CommandParameter="Fixtures" Margin="4,0" />
        </StackPanel>
    </Grid>
</UserControl>
