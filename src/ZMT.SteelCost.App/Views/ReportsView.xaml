<UserControl x:Class="ZMT.SteelCost.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20">
            <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,20" />

            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="01" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="Internal Cost Report" FontSize="18" FontWeight="SemiBold" Margin="0,8" />
                        <TextBlock Text="Malzeme, miktar, alış, maliyet, satış ve kâr detayları."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="02" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="Müşteri Raporu" FontSize="18" FontWeight="SemiBold" Margin="0,8" />
                        <TextBlock Text="Yalnızca ZMT kapsamı; iç fiyat ve kâr bilgisi içermez."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="03" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="Yükleme / Malzeme Listesi" FontSize="18" FontWeight="SemiBold" Margin="0,8" />
                        <TextBlock Text="Hafif çelik bina yükleme listesi; tüm miktarlar."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,8,14">
                    <StackPanel>
                        <TextBlock Text="Standart Rapor Oluştur" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Rapor Tipi" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Owner.ReportKinds}" SelectedItem="{Binding Owner.SelectedReportKind}"
                                  Width="300" HorizontalAlignment="Left" Margin="0,0,0,18" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="PDF Oluştur" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding Owner.ExportPdfCommand}" Margin="0,0,8,0" />
                            <Button Content="Excel Oluştur" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding Owner.ExportExcelCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,14,14" BorderBrush="#B51F29" BorderThickness="1.5">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Border DockPanel.Dock="Right" Background="#FCEBEC" CornerRadius="14" Padding="10,5">
                                <TextBlock Text="AYRI TEKLİF PDF" Foreground="#B51F29" FontWeight="Bold" FontSize="11" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Profesyonel Teklif Belgesi" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="A/B/C/D/E bölümleri ve proje verisinden teknik şartname"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PDF Dili" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Owner.OfferLanguages}"
                                          SelectedItem="{Binding Owner.SelectedOfferLanguage}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Teklif Geçerlilik (gün)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.OfferValidityDays, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Teslim / İmalat Süresi (gün)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.OfferDeliveryDays, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Content="Teknik şartnameyi PDF'e ekle"
                                      IsChecked="{Binding Owner.IncludeOfferTechnicalSpecification}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Ödeme Şekli" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                        <TextBox Text="{Binding Owner.OfferPaymentTerms, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" />

                        <TextBlock Text="Ek Teklif Notu (isteğe bağlı)" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                        <TextBox Text="{Binding Owner.OfferAdditionalNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Hızlı PDF Oluştur" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding Owner.ExportOfferPdfCommand}" />
                            <Button Content="Ayrıntılı Teklif Formunu Aç" Style="{StaticResource PrimaryButton}"
                                    Background="#B51F29" Command="{Binding Owner.NavigateCommand}" CommandParameter="OfferEditor" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Background="#EAF8F8">
                <StackPanel>
                    <TextBlock Text="Otomatik teklif bağlantısı" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                    <TextBlock Text="ZMT sorumluluğundaki gruplar dahil işlere, müşteri sorumluluğundaki gruplar hariç işlere aktarılır. Kategori tutarları, iskonto, KDV ve genel toplam son hesaplamadan alınır."
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
