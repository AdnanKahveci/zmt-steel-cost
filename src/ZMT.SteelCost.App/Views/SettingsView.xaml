<UserControl x:Class="ZMT.SteelCost.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,20">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,20" />
        <UniformGrid Columns="3">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Döviz" Style="{StaticResource SectionTitle}" /><TextBlock Text="USD/TL" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.ActiveProject.PricingSnapshot.ExchangeRate, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="Son güncelleme" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" /><TextBlock Text="{Binding Owner.ActiveProject.PricingSnapshot.LastUpdatedAt, StringFormat=g}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Metal" Style="{StaticResource SectionTitle}" /><TextBlock Text="Çelik" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.ActiveProject.PricingSnapshot.SteelPrice}" Margin="0,0,0,8" /><TextBlock Text="S Seri" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.ActiveProject.PricingSnapshot.SSeriesPrice}" Margin="0,0,0,8" /><TextBlock Text="Galvaniz" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.ActiveProject.PricingSnapshot.GalvanizedPrice}" Margin="0,0,0,8" /><TextBlock Text="Boyalı Sac" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.ActiveProject.PricingSnapshot.PaintedSheetPrice}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ticari" Style="{StaticResource SectionTitle}" /><TextBlock Text="Kâr Ekleme %" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.SalesMarkupPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" /><TextBlock Text="Excel'deki 1,73 katsayısı burada %73 olarak gösterilir." Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" /><TextBlock Text="İskonto %" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.DiscountPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" /><TextBlock Text="KDV %" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.VatPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" /><TextBlock Text="Alış KDV Oranı" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Owner.ActiveProject.PricingSnapshot.PurchaseVatRate}" /></StackPanel></Border>
        </UniformGrid>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kategori Sorumlulukları" Style="{StaticResource SectionTitle}" /><DataGrid ItemsSource="{Binding Owner.ScopeRows}" Height="330"><DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding CategoryId}" Width="100" IsReadOnly="True" /><DataGridTextColumn Header="Grup" Binding="{Binding CategoryName}" Width="*" IsReadOnly="True" /><DataGridTemplateColumn Header="Sorumluluk" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Responsibility, Converter={StaticResource EnumToTurkish}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Owner.ResponsibilityTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Responsibility}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumToTurkish}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel></Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Ayarlarla Yeniden Hesapla" Style="{StaticResource SecondaryButton}" Command="{Binding Owner.ApplyCommercialRatesCommand}" Margin="4,0" /><Button Content="Yeni Fiyat Listesi Sürümü Kaydet" Style="{StaticResource PrimaryButton}" Command="{Binding Owner.PublishPriceListVersionCommand}" Margin="4,0" /></StackPanel>
    </StackPanel></ScrollViewer>
</UserControl>
