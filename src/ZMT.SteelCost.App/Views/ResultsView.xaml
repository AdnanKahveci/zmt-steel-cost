<UserControl x:Class="ZMT.SteelCost.App.Views.ResultsView" x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ZMT.SteelCost.App.Converters"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase">
    <UserControl.Resources>
        <converters:BindingProxy x:Key="DataContextProxy" Data="{Binding}" />
        <CollectionViewSource x:Key="GroupedLines" Source="{Binding Owner.ResultLines}">
            <CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="CategoryName" /></CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="0,0,10,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,14" /></StackPanel>
        <UniformGrid Grid.Row="1" Columns="9">
            <Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="Bina Alanı" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBlock Text="{Binding Owner.ActiveProject.Building.BuildingArea, StringFormat={}{0:N1} m²}" FontSize="17" FontWeight="Bold" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="Çelik" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBlock Text="{Binding Owner.Result.SteelWeight, StringFormat={}{0:N0} kg}" FontSize="17" FontWeight="Bold" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="Tüm Gruplar" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBlock Text="{Binding Owner.Result.FullCalculatedValue, StringFormat={}{0:N0} ₺}" FontSize="17" FontWeight="Bold" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="ZMT Kapsamı" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBlock Text="{Binding Owner.Result.SupplierScopeValue, StringFormat={}{0:N0} ₺}" FontSize="17" FontWeight="Bold" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="İskonto" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBlock Text="{Binding Owner.Result.DiscountAmount, StringFormat={}{0:N0} ₺}" FontSize="17" FontWeight="Bold" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="KDV" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBlock Text="{Binding Owner.Result.VatAmount, StringFormat={}{0:N0} ₺}" FontSize="17" FontWeight="Bold" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="12" Background="#E8F8F8"><StackPanel><TextBlock Text="Nihai Teklif" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="11" /><TextBlock Text="{Binding Owner.Result.GrandTotal, StringFormat={}{0:N0} ₺}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="Brüt Kâr" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBlock Text="{Binding Owner.Result.GrossProfit, StringFormat={}{0:N0} ₺}" FontSize="17" FontWeight="Bold" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="Brüt Kâr %" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBlock Text="{Binding Owner.Result.GrossMarginRate, StringFormat=P1}" FontSize="17" FontWeight="Bold" /></StackPanel></Border>
        </UniformGrid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,14,10" Background="#F6FAFC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Kâr Ekleme %" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding Owner.SalesMarkupPercent, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,18,0" />
                <TextBlock Grid.Column="2" Text="İskonto %" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBox Grid.Column="3" Text="{Binding Owner.DiscountPercent, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,18,0" />
                <TextBlock Grid.Column="4" Text="KDV %" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBox Grid.Column="5" Text="{Binding Owner.VatPercent, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,18,0" />
                <Button Grid.Column="6" Content="Oranları Uygula ve Hesapla" Style="{StaticResource PrimaryButton}"
                        Command="{Binding Owner.ApplyCommercialRatesCommand}" />
                <TextBlock Grid.Column="7" Text="  1,73 satış katsayısı = %73 kâr ekleme"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,0,14,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><CheckBox Content="Internal fiyat kolonlarını göster" IsChecked="{Binding Owner.ShowInternalPrices}" VerticalAlignment="Center" /><TextBlock Text="   Manual satırlar ⚠ ile işaretlenir" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="PDF" Style="{StaticResource SecondaryButton}" Command="{Binding Owner.NavigateCommand}" CommandParameter="Reports" Margin="4,0" /><Button Content="Excel" Style="{StaticResource SecondaryButton}" Command="{Binding Owner.ExportExcelCommand}" Margin="4,0" /></StackPanel>
        </Grid>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Source={StaticResource GroupedLines}}" SelectedItem="{Binding Owner.SelectedResultLine}" FrozenColumnCount="3" HorizontalScrollBarVisibility="Auto" FontSize="13" RowHeight="34" ColumnHeaderHeight="38">
                <DataGrid.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander IsExpanded="True" Margin="0,2"><Expander.Header><Border Background="#E6EDF5" Padding="10,7" CornerRadius="5"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="Bold" /><TextBlock Text="{Binding ItemCount, StringFormat={} · {0} kalem}" Foreground="{StaticResource MutedTextBrush}" /></StackPanel></Border></Expander.Header><ItemsPresenter /></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" Binding="{Binding OverrideIndicator}" Width="28" IsReadOnly="True" />
                    <DataGridTextColumn Header="Kod" Binding="{Binding MaterialCode}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="Malzeme" Binding="{Binding MaterialName}" Width="250" IsReadOnly="True" />
                    <DataGridTextColumn Header="Ölçü" Binding="{Binding Specification}" Width="110" IsReadOnly="True" />
                    <DataGridTextColumn Header="Birim" Binding="{Binding Unit}" Width="65" IsReadOnly="True" />
                    <DataGridTextColumn Header="Hesaplanan" Binding="{Binding CalculatedQuantity, StringFormat=N3}" Width="95" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Mod" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Mode}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Owner.QuantityModes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Mode}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Override" Binding="{Binding OverrideQuantity, UpdateSourceTrigger=PropertyChanged}" Width="85" />
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding OverrideReason, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                    <DataGridTextColumn Header="Birim Alış" Binding="{Binding PurchaseUnitPriceExVat, StringFormat=N2}" Width="90" IsReadOnly="True" Visibility="{Binding Data.Owner.ShowInternalPrices, Source={StaticResource DataContextProxy}, Converter={StaticResource BoolToVisibility}}" />
                    <DataGridTextColumn Header="Alış Toplam" Binding="{Binding PurchaseTotalExVat, StringFormat=N2}" Width="100" IsReadOnly="True" Visibility="{Binding Data.Owner.ShowInternalPrices, Source={StaticResource DataContextProxy}, Converter={StaticResource BoolToVisibility}}" />
                    <DataGridTextColumn Header="Birim Satış" Binding="{Binding SalesUnitPrice, StringFormat=N2}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="Satış Toplam" Binding="{Binding SalesTotal, StringFormat=N2}" Width="105" IsReadOnly="True" />
                    <DataGridTextColumn Header="Kâr %" Binding="{Binding GrossMarginRate, StringFormat=P1}" Width="75" IsReadOnly="True" Visibility="{Binding Data.Owner.ShowInternalPrices, Source={StaticResource DataContextProxy}, Converter={StaticResource BoolToVisibility}}" />
                    <DataGridTemplateColumn Header="" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Uygula" Style="{StaticResource SecondaryButton}" Padding="8,4" Command="{Binding DataContext.Owner.ApplyOverrideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0"><StackPanel><TextBlock Text="Hesap Detayı" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding Owner.SelectedResultLine.MaterialName}" FontWeight="Bold" FontSize="15" /><TextBlock Text="{Binding Owner.SelectedResultLine.Trace.RuleId}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,12" /><ItemsControl ItemsSource="{Binding Owner.SelectedResultLine.Trace.Steps}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" /><TextBlock Text="{Binding Expression}" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding Result, StringFormat=N3}" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="Bold" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Bir satır seçerek formül izini görüntüleyin." Foreground="{StaticResource MutedTextBrush}" Margin="0,18,0,0" /></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
