<Window x:Class="ZMT.SteelCost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZMT Çelik Maliyet" Height="950" Width="1600"
        MinHeight="768" MinWidth="1200" WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource RailBrush}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="92" /><RowDefinition Height="*" /><RowDefinition Height="72" /></Grid.RowDefinitions>
                <StackPanel Margin="22,20">
                    <TextBlock Text="ZMT" FontSize="26" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="ÇELİK MALİYET" FontSize="11" FontWeight="SemiBold" Foreground="#65D6D8" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="ÇALIŞMA ALANI" Foreground="{StaticResource RailMutedBrush}" FontSize="10" FontWeight="Bold" Margin="24,12,0,7" />
                    <Button Style="{StaticResource NavButton}" Content="⌂  Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
                    <Button Style="{StaticResource NavButton}" Content="▣  Projeler" Command="{Binding NavigateCommand}" CommandParameter="Projects" />
                    <Button Style="{StaticResource NavButton}" Content="＋  Yeni Hesaplama" Command="{Binding NewProjectCommand}" />
                    <TextBlock Text="HESAPLAMA" Foreground="{StaticResource RailMutedBrush}" FontSize="10" FontWeight="Bold" Margin="24,20,0,7" />
                    <Button Style="{StaticResource NavButton}" Content="   Proje Bilgileri" Command="{Binding NavigateCommand}" CommandParameter="ProjectInfo" />
                    <Button Style="{StaticResource NavButton}" Content="   Bina Bilgileri" Command="{Binding NavigateCommand}" CommandParameter="Building" />
                    <Button Style="{StaticResource NavButton}" Content="   Kaplama" Command="{Binding NavigateCommand}" CommandParameter="Cladding" />
                    <Button Style="{StaticResource NavButton}" Content="   Kapı / Pencere" Command="{Binding NavigateCommand}" CommandParameter="DoorWindow" />
                    <Button Style="{StaticResource NavButton}" Content="   Vitrifiye" Command="{Binding NavigateCommand}" CommandParameter="Fixtures" />
                    <Button Style="{StaticResource NavButton}" Content="   Sonuçlar" Command="{Binding NavigateCommand}" CommandParameter="Results" />
                    <TextBlock Text="YÖNETİM" Foreground="{StaticResource RailMutedBrush}" FontSize="10" FontWeight="Bold" Margin="24,20,0,7" />
                    <Button Style="{StaticResource NavButton}" Content="◫  Malzeme ve Fiyatlar" Command="{Binding NavigateCommand}" CommandParameter="Materials" />
                    <Button Style="{StaticResource NavButton}" Content="▤  Raporlar" Command="{Binding NavigateCommand}" CommandParameter="Reports" />
                    <Button Style="{StaticResource NavButton}" Content="▣  Teklif Formu" Command="{Binding NavigateCommand}" CommandParameter="OfferEditor" />
                    <Button Style="{StaticResource NavButton}" Content="⚙  Ayarlar" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="#24344D" BorderThickness="0,1,0,0" Padding="20,12">
                    <StackPanel><TextBlock Text="FORMULA VERSION" Foreground="{StaticResource RailMutedBrush}" FontSize="10" /><TextBlock Text="LegacyExcel-v1" Foreground="White" FontWeight="SemiBold" /></StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="74" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="AKTİF PROJE" FontSize="10" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" /><TextBlock Text="{Binding ActiveProject.Company, TargetNullValue=Yeni Proje, FallbackValue=Yeni Proje}" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center"><TextBlock Text="CRM NO" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding ActiveProject.CrmNumber, TargetNullValue=—}" FontWeight="SemiBold" /></StackPanel>
                    <StackPanel Grid.Column="2" Margin="18,0" VerticalAlignment="Center"><TextBlock Text="FİYAT LİSTESİ" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding PriceListLabel}" FontWeight="SemiBold" /></StackPanel>
                    <StackPanel Grid.Column="3" Margin="18,0" VerticalAlignment="Center"><TextBlock Text="USD/TL" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding ActiveProject.PricingSnapshot.ExchangeRate, StringFormat=N2}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" /></StackPanel>
                    <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="Kaydet" Command="{Binding SaveCommand}" Margin="8" />
                    <Button Grid.Column="5" Style="{StaticResource PrimaryButton}" Content="Hesapla" Command="{Binding CalculateCommand}" Margin="8" />
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="24,22,10,8" />
            <Border Grid.Row="2" Background="#E9EEF5" Padding="14,5"><TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /></Border>
        </Grid>
    </Grid>
</Window>
